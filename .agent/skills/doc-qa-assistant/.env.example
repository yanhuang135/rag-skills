# 文档问答助手环境变量配置

# Embedding模型配置
# 推荐的开源Embedding模型：
# - BAAI/bge-base-zh (默认，中文语义理解能力强)
# - BAAI/bge-small-zh (轻量级，适合资源受限环境)
# - sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2 (多语言支持)
EMBEDDING_MODEL=BAAI/bge-base-zh
# 备用模型（主模型下载失败时自动回退）
EMBEDDING_MODEL_FALLBACK=BAAI/bge-small-zh-v1.5
# 国内网络可启用镜像
# HF_ENDPOINT=https://hf-mirror.com
# 仅使用本地已下载模型（离线环境可开启）
# EMBEDDING_LOCAL_FILES_ONLY=true

# 大模型配置 (兼容OpenAI格式)
# 示例配置：
# 1. Ollama本地部署
LLM_API_BASE=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3

# 2. 其他兼容OpenAI格式的API
# LLM_API_BASE=https://api.example.com/v1
# LLM_API_KEY=your_api_key
# LLM_MODEL=claude-3-opus-20240229
